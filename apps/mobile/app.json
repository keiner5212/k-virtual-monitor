{
  "expo": {
    "name": "k-virtual-monitor",
    "slug": "k-virtual-monitor",
    "version": "0.1.2",
    "icon": "./assets/icon.png",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101014",
    "android": {
      "package": "dev.kvm.app",
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12141a"
      }
    },
    "ios": {
      "bundleIdentifier": "dev.kvm.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to scan the pairing code of the desktop."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#101014"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "28d0fe1f-767d-4e10-8022-5415e56b519b"
      }
    }
  }
}
